# Copy to .env.local and fill in. Never commit the real key.

# Resend API key — resend.com → API keys. Sends the contact form.
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO=info@theemcreativestudio.com

# The From address. Must sit on a domain verified in Resend
# (theemcreativestudio.com is verified), or Resend rejects the send.
CONTACT_FROM=The EM Creative Studio <website@theemcreativestudio.com>
